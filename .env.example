# ──────────────────────────────────────────────
#  Masterplan Engine — Environment Variables
#  Copy this file to .env and fill in the values
# ──────────────────────────────────────────────

# ✅ REQUIRED — Anthropic Claude API key (for AI layout generation)
# Get yours at: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ✅ REQUIRED — Claude model version (leave as-is unless you want a different model)
ANTHROPIC_MODEL=claude-sonnet-4-6

# ──────── Automatically set by docker-compose — do NOT change ────────
# REDIS_URL=redis://redis:6379/0
# PORT=8001
